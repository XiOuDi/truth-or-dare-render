# 环境变量示例（复制为 .env 用于本地调试；Render 部署无需本文件）
# 注意：Render 部署时敏感配置（BOT_TOKEN 等）请写入 Upstash，不要填在 GitHub 任何文件中。

# ---- 必填：Upstash Redis（REST）----
# Render 部署时在 Render 的环境变量中配置这两个值；
# 本地调试时填在本文件，或使用旧字段名 UPSTASH_URL / UPSTASH_TOKEN。
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# ---- 可选：敏感配置（也可全部存入 Upstash，bot 启动时自动拉取）----
# BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# PROXY=http://127.0.0.1:7890

# ---- 可选：运行模式（默认自动判断：Render=webhook，本地=polling）----
# MODE=webhook
# WEBHOOK_URL=https://xxx.onrender.com
# WEBHOOK_PATH=/webhook
# WEBHOOK_PORT=8081
